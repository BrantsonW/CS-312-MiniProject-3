<!DOCTYPE html>
<html lang="en">

<head>
    
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>EDIT POST</title>
    <link rel="stylesheet" href="/style.css">

</head>

<body>

    <header>

        <h1>EDIT POST</h1>
        <p>MAKE YOUR CHANGES</p>

    </header>

    <main>
        <section>

            <form action="/posts/<%= post.blog_id %>/edit" method="POST">

                <div>
                    <label for="title">EDIT TITLE</label>

                    <input
                        type="text"
                        id="title"
                        name="title"
                        value="<%= post.title %>"
                        required
                    >
                </div>

                <div>
                    <label for="content">EDIT BLOG</label>

                    <textarea
                        id="content"
                        name="content"
                        rows="8"
                        required
                    ><%= post.body %></textarea>
                </div>

                <button type="submit">SAVE</button>

            </form>

            <p>
                <a href="/">CANCEL</a>
            </p>

        </section>
    </main>

</body>

</html>