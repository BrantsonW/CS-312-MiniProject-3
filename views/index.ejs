<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>My Blog</title>

    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <header>

        <h1>MY MIND BLOG</h1>
        <p>WHATS ON YOUR MIND?!</p>

        <% if (currentUser) { %>

            <br>

            <p>WELCOME, <%= currentUser.name %>!</p>

            <br>

            <form action="/logout" method="POST">
                <button type="submit">LOG OUT</button>
            </form>

        <% } else { %>

            <br>

            <p>
                <a href="/signin">SIGN IN</a>
                |
                <a href="/signup">SIGN UP</a>
            </p>

        <% } %>
        
    </header>

    <main>

        <!-- CREATING POSTS -->
        <% if (currentUser) { %>

            <section>
                <h2>CREATE A POST</h2>

                <form action="/posts" method="POST">

                    <div>
                        <label for="title">TITLE</label>
                        <input type="text" id="title" name="title" required>
                    </div>

                    <div>
                        <label for="content">BLOG</label>
                        <textarea id="content" name="content" rows="8" required></textarea>
                    </div>

                    <button type="submit">POST</button>

                </form>
            </section>

        <% } %>

        <!-- VIEWING POSTS -->

        <section>

            <h2>RECENT POSTS</h2>

            <% if (posts.length === 0) { %>
                <p>no posts have been made</p>
            <% } %>

            <% posts.forEach(post => { %>
                <article>

                    <h3><%= post.title %></h3>

                    <p>
                        By <strong><%= post.creator_name %></strong>
                    </p>

                    <p>
                        <%= new Date(post.date_created).toLocaleString() %>
                    </p>

                    <p>
                        <%= post.body %>
                    </p>

                    <% if (currentUser && currentUser.id === post.creator_user_id) { %>

                        <a href="/posts/<%= post.blog_id %>/edit">EDIT</a>

                        <form action="/posts/<%= post.blog_id %>/delete" method="POST">
                            <button type="submit">DELETE</button>
                        </form>

                    <% } %>

                </article>
            <% }); %>

        </section>

    </main>
</body>

</html>